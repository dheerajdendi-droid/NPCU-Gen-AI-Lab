# Copy this template to an ignored .env for local configuration.
NPCU_ENVIRONMENT=development
NPCU_LOG_LEVEL=INFO

# Gate 3 live-provider settings. Never put real credentials in this tracked file.
OPENAI_API_KEY=replace-with-openai-api-key
PINECONE_API_KEY=replace-with-pinecone-api-key
PINECONE_INDEX_NAME=replace-with-pinecone-index-name
PINECONE_NAMESPACE=replace-with-pinecone-namespace
